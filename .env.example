# Only external API credential required. Never commit your real .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Set true ONLY behind HTTPS. Cookies are HttpOnly and SameSite=Strict.
COOKIE_SECURE=false
# Optional exact browser origin; defaults to http://localhost:PORT
PUBLIC_ORIGIN=http://localhost:3000
DEMO_MODE=false
